class TreeElement:
    def __init__(self, key):
        self.key = key
        self.left = None
        self.right = None
        self.height = 1


def get_height(element):
    if element is None:
        return 0
    return element.height


def update_height(element):
    element.height = 1 + max(get_height(element.left), get_height(element.right))


def get_balance(element):
    return get_height(element.right) - get_height(element.left)


def rotate_left(element):
    new_top = element.right
    element.right = new_top.left
    new_top.left = element

    update_height(element)
    update_height(new_top)
    return new_top


def rotate_right(element):
    new_top = element.left
    element.left = new_top.right
    new_top.right = element

    update_height(element)
    update_height(new_top)
    return new_top


def balance(element):
    update_height(element)

    if get_balance(element) == 2:
        if get_balance(element.right) < 0:
            element.right = rotate_right(element.right)
        return rotate_left(element)

    if get_balance(element) == -2:
        if get_balance(element.left) > 0:
            element.left = rotate_left(element.left)
        return rotate_right(element)

    return element


def add(root, x):
    if root is None:
        return TreeElement(x)

    if x < root.key:
        root.left = add(root.left, x)
    elif x > root.key:
        root.right = add(root.right, x)
    else:
        return root

    return balance(root)


def delete(root, x):
    if root is None:
        return None

    if x < root.key:
        root.left = delete(root.left, x)
    elif x > root.key:
        root.right = delete(root.right, x)
    else:
        if root.left is None:
            return root.right

        if root.right is None:
            return root.left

        min_element = root.right
        while min_element.left is not None:
            min_element = min_element.left

        root.key = min_element.key
        root.right = delete(root.right, min_element.key)

    return balance(root)


def exists(root, x):
    while root is not None:
        if x == root.key:
            return True
        if x < root.key:
            root = root.left
        else:
            root = root.right

    return False


def next_key(root, x):
    answer = None

    while root is not None:
        if root.key >= x:
            answer = root.key
            root = root.left
        else:
            root = root.right

    return answer


def prev_key(root, x):
    answer = None

    while root is not None:
        if root.key <= x:
            answer = root.key
            root = root.right
        else:
            root = root.left

    return answer


def preorder(root, result):
    if root is None:
        return

    result.append(str(root.key))
    preorder(root.left, result)
    preorder(root.right, result)


q = int(input())
root = None

for _ in range(q):
    command = input().split()
    operation = command[0]

    if operation == "add":
        root = add(root, int(command[1]))

    elif operation == "del":
        root = delete(root, int(command[1]))

    elif operation == "exists":
        print("YES" if exists(root, int(command[1])) else "NO")

    elif operation == "next":
        print(next_key(root, int(command[1])))

    elif operation == "prev":
        print(prev_key(root, int(command[1])))

    elif operation == "root":
        print(root.key if root is not None else "Empty")

    elif operation == "height":
        print(get_height(root))

    elif operation == "print":
        if root is None:
            print("Empty")
        else:
            result = []
            preorder(root, result)
            print(" ".join(result))
